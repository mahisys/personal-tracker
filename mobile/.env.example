# Copy this file to `.env` and adjust for your setup, then restart `expo start`.

# Android emulator talking to a backend running on your host machine (default
# if this variable is unset).
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# iOS simulator (can reach the host machine's localhost directly):
# EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Physical device on the same Wi-Fi as your dev machine — replace with your
# machine's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api

# Production / staging backend:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
