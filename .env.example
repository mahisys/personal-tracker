DATABASE_URL=postgres://postgres@localhost:5432/command_center
# Local only: skip Firebase login. Never set in production.
AUTH_MODE=dev
ALLOWED_EMAILS=you@example.com
APP_URL=http://localhost:3000
CRON_SECRET=local-cron-secret
# Firebase web config (production values are injected by Terraform)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
# Files go to .data/uploads when GCS_BUCKET is empty
GCS_BUCKET=
# Optional Gmail API sender
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
