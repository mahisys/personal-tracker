// Personal Tracker backend data model.
// SQLite by default (zero-config, file-based) — swap the datasource to postgresql for production
// by changing `provider` and `DATABASE_URL` in .env, schema is compatible with both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite has no native enum type and Prisma's sqlite connector does not support
// `enum` blocks at all (it's a hard schema-validation error, not just a style choice).
// The value sets below are unchanged from the original design — they are just declared
// as `String` fields with the same defaults, validated at the application layer (zod)
// and via TypeScript union/const types instead of a Prisma-level enum.
//
// TaskStatus:       "YTS" | "WIP" | "DONE" (OVERDUE is never stored — derived at read-time)
// CollaboratorRole: "OWNER" | "EDITOR" | "VIEWER"
// AttachmentType:   "FILE" | "LINK"
// NotificationType: "REMINDER" | "SHARE_INVITE" | "STATUS_CHANGE" | "COMMENT"
// Platform:         "ANDROID" | "IOS" | "WEB"

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedTasks      Task[]             @relation("OwnedTasks")
  collaborations  TaskCollaborator[]
  pushTokens      PushToken[]
  notifications   Notification[]
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("ANDROID")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Task {
  id                String     @id @default(uuid())
  title             String
  description       String?
  dueDate           DateTime   // date + time the task is scheduled for
  reminderAt        DateTime?  // when to fire the alarm / push+in-app notification
  reminderNotified  Boolean    @default(false)
  status            String     @default("YTS")
  ownerId           String
  owner             User       @relation("OwnedTasks", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  attachments   Attachment[]
  collaborators TaskCollaborator[]
  notifications Notification[]

  @@index([ownerId])
  @@index([dueDate])
  @@index([reminderAt, reminderNotified])
}

model TaskCollaborator {
  id        String           @id @default(uuid())
  taskId    String
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?          // null until the invited email registers/accepts
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String           // invited email, always set
  role      String           @default("EDITOR")
  createdAt DateTime         @default(now())

  @@unique([taskId, email])
  @@index([userId])
}

model Attachment {
  id        String         @id @default(uuid())
  taskId    String
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  url       String         // /uploads/<file> for FILE, or the raw URL for LINK
  filename  String?
  mimeType  String?
  size      Int?
  createdAt DateTime       @default(now())

  @@index([taskId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}
